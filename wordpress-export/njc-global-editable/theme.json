{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1120px"
    },
    "color": {
      "palette": [
        { "slug": "njc-green", "name": "NJC Green", "color": "#064e3b" },
        { "slug": "njc-ink", "name": "NJC Ink", "color": "#14352c" },
        { "slug": "njc-cream", "name": "NJC Cream", "color": "#f8f5ed" },
        { "slug": "njc-gold", "name": "NJC Gold on Light", "color": "#b67d35" },
        { "slug": "njc-gold-bright", "name": "NJC Gold on Dark", "color": "#feaf35" },
        { "slug": "njc-gold-soft", "name": "NJC Soft Gold", "color": "#ffcf88" },
        { "slug": "white", "name": "White", "color": "#ffffff" }
      ]
    },
    "typography": {
      "fontFamilies": [
        { "slug": "njc-sans", "name": "Hanken Grotesk", "fontFamily": "'Hanken Grotesk', sans-serif" },
        { "slug": "njc-serif", "name": "Playfair Display", "fontFamily": "'Playfair Display', serif" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "#f8f5ed",
      "text": "#14352c"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--njc-sans)",
      "fontSize": "16px",
      "lineHeight": "1.7"
    }
  }
}
